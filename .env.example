# Retina Node - Standalone Configuration
# Copy to .env: cp .env.example .env
#
# For standalone deployments (without Mender).
# Edit config/config.yml for radar settings (copy from config/default.yml first).

# --- Standalone mode (required) ---
SKIP_CONFIG_MERGER=true
CONFIG_DIR=./config
DATA_DIR=./data

# --- Location (for tar1090 ADS-B map) ---
RECEIVER_LAT=0
RECEIVER_LON=0
RECEIVER_ALT=0

# --- ADS-B settings ---
# External ADS-B feed: host,port,protocol (e.g., 192.168.1.100,30005,beast_in)
# READSB_NET_CONNECTOR=

# adsb.lol fallback when no local ADS-B feed available
ADSBLOL_ENABLED=true
ADSBLOL_RADIUS=40

# --- Image versions (uncomment to override) ---
# BLAH2_V=v0.3.0
# TAR1090_V=v0.2.0
# ADSB2DD_V=v0.1.3
# CONFIG_MERGER_V=v0.3.2

# --- Ports (uncomment to change) ---
# BLAH2_WEB_PORT=49152
# BLAH2_HOST_PORT=8080
# TAR1090_PORT=8078
