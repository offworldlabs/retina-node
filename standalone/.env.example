# Standalone configuration
# Copy to .env and edit as needed

# --- Paths ---
CONFIG_PATH=./config
DATA_PATH=./data

# --- Image tags ---

# blah2 stack (blah2, blah2-api, blah2-web, blah2-host)
BLAH2_TAG=dev

# Config merger (retina-node repo) - only used with --profile full
CONFIG_MERGER_TAG=v0.3.2

# tar1090-node
TAR1090_TAG=v0.2.0

# adsb2dd
ADSB2DD_TAG=v0.1.3

# --- Optional: tar1090 location settings ---
# RECEIVER_LAT=0
# RECEIVER_LON=0
# RECEIVER_ALT=0
# ADSBLOL_ENABLED=false
# ADSBLOL_RADIUS=40
