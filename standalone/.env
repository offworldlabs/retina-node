# Standalone configuration
# Edit values below for your setup

# --- Paths ---
CONFIG_PATH=./config
DATA_PATH=./data

# --- Image tags (optional) ---
# By default, docker-compose uses the versions defined in docker-compose.yml
# Uncomment and edit these to quickly swap container versions for dev/testing
# e.g., BLAH2_TAG=dev for latest builds, or BLAH2_TAG=v0.3.0 for a specific release

# BLAH2_TAG=dev
# TAR1090_TAG=v0.2.0
# ADSB2DD_TAG=v0.1.3

# --- tar1090 location settings ---
# Set your receiver location for accurate ADS-B coverage maps
RECEIVER_LAT=37.7644
RECEIVER_LON=-122.3954
RECEIVER_ALT=23

# --- tar1090 ADS-B settings ---

# External ADS-B feed (optional) - format: host,port,protocol
# Example: 192.168.1.100,30005,beast_in
READSB_NET_CONNECTOR=

# adsb.lol fallback - fetches ADS-B data when no local feed available
ADSBLOL_ENABLED=true
ADSBLOL_RADIUS=40
